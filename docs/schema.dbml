// Flag-It database schema. GENERATED by `python -m flag_it.db.dbml` from the migrations. Do not edit.
// To change a table, add a migration in src/flag_it/db/migrations/versions/, then regenerate.
// Field meanings: docs/contracts.md. View as a diagram: paste into https://dbdiagram.io.
//
// Conventions
// - Keys are UUIDs generated in Python, so any machine can create rows.
// - Money is numeric(12,2). Scores are double precision, so Python floats read back exactly.
// - Every table is append-only: triggers reject UPDATE, DELETE, and TRUNCATE. The one exception is
//   decision_run, whose route, decided_by, and escalation_reasons are filled in once, when the agent finishes.
// - Check constraints are listed as comments inside each table.

Project flag_it {
  database_type: 'PostgreSQL'
}

Table raw_transaction {
  raw_id uuid [pk]
  source_file text
  source_line_no integer
  source text
  external_id text
  source_rowid text [note: 'State ROWID. Not an identifier: reused across monthly files.']
  calendar_year text
  calendar_month text
  agencynbr text
  agencyname text
  last_name text
  first_initial text
  item_descr text
  amount text
  merchant_name text
  transaction_date text
  post_date text
  mcc_description text
  mcc_code text
  business_purpose text
  loaded_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (source, external_id) [unique, name: 'raw_transaction_api_item']
    (source_file, source_line_no) [unique, name: 'raw_transaction_file_row']
  }

  // raw_transaction_one_origin: CHECK ((((source_file IS NOT NULL) AND (source_line_no IS NOT NULL) AND (source IS NULL) AND (external_id IS NULL)) OR ((source_file IS NULL) AND (source_line_no IS NULL) AND (source IS NOT NULL) AND (external_id IS NOT NULL))))
  // raw_transaction_source_line_no_check: CHECK ((source_line_no >= 1))

  Note: 'One source row exactly as received. Every source field is text.'
}

Table txn {
  txn_id uuid [pk]
  raw_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    raw_id [unique, name: 'txn_one_per_raw']
    (txn_id, raw_id) [unique, name: 'txn_raw_pair']
  }

  Note: 'Transaction identity. Intake assigns txn_id before normalization runs.'
}

Table normalized_transaction {
  txn_id uuid [not null]
  normalizer_version text [not null]
  raw_id uuid [not null]
  agency_id text [not null]
  cardholder_id text [not null, note: 'Stand-in key agency_id|LASTNAME|I until a real card ID exists.']
  merchant_norm text [not null]
  mcc_description text [not null]
  mcc_code text
  amount numeric(12,2) [not null]
  transaction_date date [not null]
  post_date date [not null]
  business_purpose text
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (txn_id, normalizer_version) [pk]
    (agency_id, transaction_date) [name: 'normalized_transaction_agency_date']
    (cardholder_id, transaction_date) [name: 'normalized_transaction_cardholder_date']
    (cardholder_id, merchant_norm, transaction_date) [name: 'normalized_transaction_cardholder_merchant_date']
  }

  // normalized_transaction_agency_id_check: CHECK ((agency_id <> ''::text))
  // normalized_transaction_cardholder_id_check: CHECK ((cardholder_id <> ''::text))
  // normalized_transaction_mcc_code_check: CHECK ((mcc_code ~ '^\d{4}$'::text))
  // normalized_transaction_mcc_description_check: CHECK ((mcc_description <> ''::text))
  // normalized_transaction_merchant_norm_check: CHECK ((merchant_norm <> ''::text))
  // normalized_transaction_normalizer_version_check: CHECK ((normalizer_version <> ''::text))

  Note: 'Typed version of a raw row, one row per normalizer version.'
}

Table receipt_file {
  receipt_id uuid [pk]
  txn_id uuid [not null]
  storage_key text [not null, note: 'Object key in the receipt store (MinIO).']
  content_type text [not null]
  sha256 text [not null]
  size_bytes bigint [not null]
  uploaded_at "timestamp with time zone" [not null]

  indexes {
    (receipt_id, txn_id) [unique, name: 'receipt_file_txn_pair']
  }

  // receipt_file_content_type_check: CHECK ((content_type <> ''::text))
  // receipt_file_sha256_check: CHECK ((sha256 ~ '^[0-9a-f]{64}$'::text))
  // receipt_file_size_bytes_check: CHECK ((size_bytes > 0))
  // receipt_file_storage_key_check: CHECK ((storage_key <> ''::text))

  Note: 'An uploaded receipt. The read_receipt worker finds the file by receipt_id.'
}

Table receipt_extraction {
  receipt_id uuid [not null]
  reader_model text [not null]
  txn_id uuid [not null]
  match_status text [not null]
  merchant text
  receipt_date date
  subtotal numeric(12,2)
  tax numeric(12,2)
  tip numeric(12,2)
  total numeric(12,2)
  line_items jsonb [not null, default: `'[]'::jsonb`]
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (receipt_id, reader_model) [pk]
  }

  // receipt_extraction_line_items_check: CHECK ((jsonb_typeof(line_items) = 'array'::text))
  // receipt_extraction_match_status_check: CHECK ((match_status = ANY (ARRAY['matched'::text, 'mismatch'::text, 'unmatched'::text])))
  // receipt_extraction_reader_model_check: CHECK ((reader_model <> ''::text))

  Note: 'What one reader model read from one receipt. Unreadable fields are null.'
}

Table category_result {
  txn_id uuid [not null]
  model_version text [not null]
  category text [not null, note: 'A category ID from the rules YAML.']
  confidence "double precision" [not null]
  method text [not null]
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (txn_id, model_version) [pk]
  }

  // category_result_category_check: CHECK ((category <> ''::text))
  // category_result_confidence_check: CHECK (((confidence >= (0)::double precision) AND (confidence <= (1)::double precision)))
  // category_result_method_check: CHECK ((method = ANY (ARRAY['lookup'::text, 'model'::text])))
  // category_result_model_version_check: CHECK ((model_version <> ''::text))
}

Table anomaly_result {
  txn_id uuid [not null]
  model_version text [not null]
  status text [not null]
  score "double precision"
  history_length integer [not null]
  as_of "timestamp with time zone" [not null, note: 'Only history before this time was used.']
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (txn_id, model_version) [pk]
  }

  // anomaly_result_history_length_check: CHECK ((history_length >= 0))
  // anomaly_result_model_version_check: CHECK ((model_version <> ''::text))
  // anomaly_result_score_matches_status: CHECK (((status = 'scored'::text) = (score IS NOT NULL)))
  // anomaly_result_status_check: CHECK ((status = ANY (ARRAY['scored'::text, 'insufficient_history'::text])))
}

Table combined_expense_snapshot {
  snapshot_id uuid [pk]
  txn_id uuid [not null]
  payload jsonb [not null]
  source_versions jsonb [not null]
  contract_version text [not null]
  created_at "timestamp with time zone" [not null]

  indexes {
    (snapshot_id, txn_id) [unique, name: 'combined_expense_snapshot_txn_pair']
  }

  // combined_expense_snapshot_contract_version_check: CHECK ((contract_version ~ '^\d+\.\d+\.\d+$'::text))
  // combined_expense_snapshot_payload_txn: CHECK ((((payload -> 'transaction'::text) ->> 'txn_id'::text) = (txn_id)::text))

  Note: 'The frozen input to one decision run.'
}

Table decision_run {
  decision_id uuid [pk]
  txn_id uuid [not null]
  snapshot_id uuid [not null]
  route text [note: 'Null while the agent works, then filled in once.']
  decided_by text
  trigger text [not null]
  replaces_decision_id uuid
  screener_probability "double precision"
  screener_threshold "double precision"
  screener_model_version text
  escalation_reasons "text[]" [not null, default: `'{}'::text[]`]
  rules_version text [not null]
  created_at "timestamp with time zone" [not null]

  indexes {
    snapshot_id [unique, name: 'decision_run_one_per_snapshot']
    replaces_decision_id [unique, name: 'decision_run_replaced_once']
    (decision_id, txn_id) [unique, name: 'decision_run_txn_pair']
    txn_id [unique, name: 'decision_run_one_initial', note: 'where (trigger = \'initial\'::text)']
    (txn_id, created_at) [name: 'decision_run_txn_created']
  }

  // decision_run_decided_by_check: CHECK ((decided_by = ANY (ARRAY['rules'::text, 'screener'::text, 'agent'::text, 'guardrails'::text, 'rerun'::text])))
  // decision_run_escalation_iff_human_review: CHECK (((COALESCE(route, ''::text) = 'human_review'::text) = (cardinality(escalation_reasons) > 0)))
  // decision_run_replaces_unless_initial: CHECK (((trigger = 'initial'::text) = (replaces_decision_id IS NULL)))
  // decision_run_route_check: CHECK ((route = ANY (ARRAY['flag'::text, 'auto_approve'::text, 'agent_approve'::text, 'agent_flag'::text, 'human_review'::text])))
  // decision_run_route_with_decider: CHECK (((route IS NULL) = (decided_by IS NULL)))
  // decision_run_rules_version_check: CHECK ((rules_version <> ''::text))
  // decision_run_screener_complete: CHECK ((num_nonnulls(screener_probability, screener_threshold, screener_model_version) = ANY (ARRAY[0, 3])))
  // decision_run_screener_probability_check: CHECK (((screener_probability >= (0)::double precision) AND (screener_probability <= (1)::double precision)))
  // decision_run_screener_threshold_check: CHECK (((screener_threshold >= (0)::double precision) AND (screener_threshold <= (1)::double precision)))
  // decision_run_trigger_check: CHECK ((trigger = ANY (ARRAY['initial'::text, 'late_receipt'::text, 'deadline'::text])))

  Note: 'One pass of the Decide stages over one snapshot. Reruns form one chain per transaction.'
}

Table flag {
  flag_id uuid [pk]
  decision_id uuid [not null]
  txn_id uuid [not null]
  rule_id text [not null]
  check_id text [not null]
  result text [not null]
  severity text [not null]
  evidence jsonb [not null]
  score "double precision" [not null]
  source text [not null]
  due_at "timestamp with time zone" [note: 'When a pending check deadline passes. The deadline job reads it.']
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (decision_id, check_id) [unique, name: 'flag_one_per_check']
    due_at [name: 'flag_pending_due', note: 'where (result = \'pending\'::text)']
    (rule_id, created_at) [name: 'flag_rule_created']
  }

  // flag_check_of_rule: CHECK ((check_id ~ (('^'::text || rule_id) || '[a-z]+$'::text)))
  // flag_due_at_iff_pending: CHECK (((result = 'pending'::text) = (due_at IS NOT NULL)))
  // flag_evidence_check: CHECK ( CASE WHEN (jsonb_typeof(evidence) = 'array'::text) THEN (jsonb_array_length(evidence) > 0) ELSE false END)
  // flag_result_check: CHECK ((result = ANY (ARRAY['fail'::text, 'violation'::text, 'unclear'::text, 'pending'::text, 'not_evaluated'::text])))
  // flag_score_check: CHECK (((score >= (0)::double precision) AND (score <= (1)::double precision)))
  // flag_severity_check: CHECK ((severity = ANY (ARRAY['prohibited'::text, 'conditional'::text, 'documentation'::text, 'guidance'::text])))
  // flag_source_check: CHECK ((source = ANY (ARRAY['code'::text, 'llm'::text])))
}

Table agent_verdict {
  decision_id uuid [not null]
  check_id text [not null]
  result text [not null]
  confidence "double precision" [not null]
  evidence jsonb [not null, default: `'[]'::jsonb`]
  created_at "timestamp with time zone" [not null, default: `clock_timestamp()`]

  indexes {
    (decision_id, check_id) [pk]
  }

  // agent_verdict_check_id_check: CHECK ((check_id ~ '^[A-Z0-9]+(-[A-Z0-9]+)+[a-z]+$'::text))
  // agent_verdict_confidence_check: CHECK (((confidence >= (0)::double precision) AND (confidence <= (1)::double precision)))
  // agent_verdict_evidence_check: CHECK ((jsonb_typeof(evidence) = 'array'::text))
  // agent_verdict_result_check: CHECK ((result = ANY (ARRAY['pass'::text, 'fail'::text, 'unsure'::text])))

  Note: 'The agent answer for one llm check in one run, as the guardrails received it.'
}

Table review_outcome {
  review_id uuid [pk]
  decision_id uuid [not null]
  reviewer text [not null]
  final text [not null]
  per_flag jsonb [not null, default: `'[]'::jsonb`]
  missed_rule_ids "text[]" [not null, default: `'{}'::text[]`]
  reason text
  created_at "timestamp with time zone" [not null]

  indexes {
    (decision_id, created_at) [name: 'review_outcome_decision_created']
  }

  // review_outcome_final_check: CHECK ((final = ANY (ARRAY['approve'::text, 'flag'::text])))
  // review_outcome_per_flag_check: CHECK ((jsonb_typeof(per_flag) = 'array'::text))
  // review_outcome_reviewer_check: CHECK ((reviewer <> ''::text))
}

Ref txn_raw_id_fkey: txn.raw_id > raw_transaction.raw_id
Ref normalized_transaction_txn: normalized_transaction.(txn_id, raw_id) > txn.(txn_id, raw_id)
Ref receipt_file_txn_id_fkey: receipt_file.txn_id > txn.txn_id
Ref receipt_extraction_file: receipt_extraction.(receipt_id, txn_id) > receipt_file.(receipt_id, txn_id)
Ref category_result_txn_id_fkey: category_result.txn_id > txn.txn_id
Ref anomaly_result_txn_id_fkey: anomaly_result.txn_id > txn.txn_id
Ref combined_expense_snapshot_txn_id_fkey: combined_expense_snapshot.txn_id > txn.txn_id
Ref decision_run_replaces: decision_run.(replaces_decision_id, txn_id) > decision_run.(decision_id, txn_id)
Ref decision_run_snapshot: decision_run.(snapshot_id, txn_id) > combined_expense_snapshot.(snapshot_id, txn_id)
Ref decision_run_txn_id_fkey: decision_run.txn_id > txn.txn_id
Ref flag_run: flag.(decision_id, txn_id) > decision_run.(decision_id, txn_id)
Ref agent_verdict_decision_id_fkey: agent_verdict.decision_id > decision_run.decision_id
Ref review_outcome_decision_id_fkey: review_outcome.decision_id > decision_run.decision_id
