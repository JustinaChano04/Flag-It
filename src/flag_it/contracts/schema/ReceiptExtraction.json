{
  "$defs": {
    "LineType": {
      "enum": [
        "item",
        "tax",
        "tip",
        "fee",
        "room",
        "other"
      ],
      "title": "LineType",
      "type": "string"
    },
    "MatchStatus": {
      "enum": [
        "matched",
        "mismatch",
        "unmatched"
      ],
      "title": "MatchStatus",
      "type": "string"
    },
    "ReceiptLineItem": {
      "properties": {
        "amount": {
          "anyOf": [
            {
              "decimal_places": 2,
              "max_digits": 12,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "line_type": {
          "$ref": "#/$defs/LineType",
          "default": "item"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit_price": {
          "anyOf": [
            {
              "decimal_places": 2,
              "max_digits": 12,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        }
      },
      "title": "ReceiptLineItem",
      "type": "object"
    }
  },
  "description": "What the reader got from one receipt file. Unreadable fields stay empty.",
  "properties": {
    "line_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReceiptLineItem"
      },
      "title": "Line Items",
      "type": "array"
    },
    "match_status": {
      "$ref": "#/$defs/MatchStatus"
    },
    "merchant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merchant"
    },
    "reader_model": {
      "minLength": 1,
      "title": "Reader Model",
      "type": "string"
    },
    "receipt_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Date"
    },
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "subtotal": {
      "anyOf": [
        {
          "decimal_places": 2,
          "max_digits": 12,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtotal"
    },
    "tax": {
      "anyOf": [
        {
          "decimal_places": 2,
          "max_digits": 12,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tax"
    },
    "tip": {
      "anyOf": [
        {
          "decimal_places": 2,
          "max_digits": 12,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tip"
    },
    "total": {
      "anyOf": [
        {
          "decimal_places": 2,
          "max_digits": 12,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total"
    },
    "txn_id": {
      "format": "uuid",
      "title": "Txn Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "txn_id",
    "reader_model",
    "match_status"
  ],
  "title": "ReceiptExtraction",
  "type": "object"
}
