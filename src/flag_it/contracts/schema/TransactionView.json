{
  "$defs": {
    "Citation": {
      "description": "One piece of evidence. The guardrails check that `ref` exists.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DecidedBy": {
      "enum": [
        "rules",
        "screener",
        "agent",
        "guardrails",
        "rerun"
      ],
      "title": "DecidedBy",
      "type": "string"
    },
    "DecisionRun": {
      "description": "One pass of the Decide stages over one snapshot. Route is empty while the agent works.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecidedBy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "escalation_reasons": {
          "default": [],
          "items": {
            "pattern": "^((unsure|low_confidence):[A-Z0-9]+(-[A-Z0-9]+)+[a-z]+|citation_unresolved|invalid_output|agent_failed|review_conflict)$",
            "type": "string"
          },
          "title": "Escalation Reasons",
          "type": "array"
        },
        "replaces_decision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces Decision Id"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Route"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rules_version": {
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "screener": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScreenerResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/RunTrigger"
        },
        "txn_id": {
          "format": "uuid",
          "title": "Txn Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "txn_id",
        "snapshot_id",
        "trigger",
        "rules_version",
        "created_at"
      ],
      "title": "DecisionRun",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "field",
        "receipt",
        "policy",
        "tool_result",
        "history"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Flag": {
      "properties": {
        "check_id": {
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+[a-z]+$",
          "title": "Check Id",
          "type": "string"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "flag_id": {
          "format": "uuid",
          "title": "Flag Id",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/FlagResult"
        },
        "rule_id": {
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$",
          "title": "Rule Id",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "$ref": "#/$defs/FlagSource"
        },
        "txn_id": {
          "format": "uuid",
          "title": "Txn Id",
          "type": "string"
        }
      },
      "required": [
        "flag_id",
        "decision_id",
        "txn_id",
        "rule_id",
        "check_id",
        "result",
        "severity",
        "evidence",
        "score",
        "source"
      ],
      "title": "Flag",
      "type": "object"
    },
    "FlagResult": {
      "enum": [
        "fail",
        "violation",
        "unclear",
        "pending",
        "not_evaluated"
      ],
      "title": "FlagResult",
      "type": "string"
    },
    "FlagSource": {
      "enum": [
        "code",
        "llm"
      ],
      "title": "FlagSource",
      "type": "string"
    },
    "NormalizedTransaction": {
      "description": "The typed version of a raw row. Raw text stays in the raw row.",
      "properties": {
        "agency_id": {
          "minLength": 1,
          "title": "Agency Id",
          "type": "string"
        },
        "amount": {
          "decimal_places": 2,
          "max_digits": 12,
          "title": "Amount",
          "type": "string"
        },
        "business_purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Purpose"
        },
        "cardholder_id": {
          "minLength": 1,
          "title": "Cardholder Id",
          "type": "string"
        },
        "mcc_code": {
          "anyOf": [
            {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcc Code"
        },
        "mcc_description": {
          "minLength": 1,
          "title": "Mcc Description",
          "type": "string"
        },
        "merchant_norm": {
          "minLength": 1,
          "title": "Merchant Norm",
          "type": "string"
        },
        "normalizer_version": {
          "minLength": 1,
          "title": "Normalizer Version",
          "type": "string"
        },
        "post_date": {
          "format": "date",
          "title": "Post Date",
          "type": "string"
        },
        "raw_id": {
          "format": "uuid",
          "title": "Raw Id",
          "type": "string"
        },
        "transaction_date": {
          "format": "date",
          "title": "Transaction Date",
          "type": "string"
        },
        "txn_id": {
          "format": "uuid",
          "title": "Txn Id",
          "type": "string"
        }
      },
      "required": [
        "txn_id",
        "raw_id",
        "agency_id",
        "cardholder_id",
        "merchant_norm",
        "mcc_description",
        "amount",
        "transaction_date",
        "post_date",
        "normalizer_version"
      ],
      "title": "NormalizedTransaction",
      "type": "object"
    },
    "Route": {
      "enum": [
        "flag",
        "auto_approve",
        "agent_approve",
        "agent_flag",
        "human_review"
      ],
      "title": "Route",
      "type": "string"
    },
    "RunTrigger": {
      "enum": [
        "initial",
        "late_receipt",
        "deadline"
      ],
      "title": "RunTrigger",
      "type": "string"
    },
    "ScreenerResult": {
      "properties": {
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "probability",
        "threshold",
        "model_version"
      ],
      "title": "ScreenerResult",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "prohibited",
        "conditional",
        "documentation",
        "guidance"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "description": "GET /transactions/{txn_id}. `decision` is empty until the first run has a route.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Contract Version",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flags": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Flag"
      },
      "title": "Flags",
      "type": "array"
    },
    "transaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedTransaction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "txn_id": {
      "format": "uuid",
      "title": "Txn Id",
      "type": "string"
    }
  },
  "required": [
    "txn_id"
  ],
  "title": "TransactionView",
  "type": "object"
}
